    \int_gset_eq:NN #1 \c@maxflow
   }
  \bool_gset_true:N \g__flowfram_not_this_frame_bool
  \bool_gset_false:N \g__flowfram_new_page_bool
  \int_set_eq:NN \l__flowfram_col_int #1
