%\changes{1.17}{2014-09-30}{added check for list}
%    \begin{macrocode}
    \int_compare:nNnTF { \@listdepth } > { \c_zero_int }
     {
       \dim_compare:nNnT { \linewidth } > { \columnwidth }
        {
          \dim_gset_eq:NN \linewidth \columnwidth
        }
     }
     {
        \dim_gset_eq:NN \linewidth \columnwidth
     }
