\pgfdeclareshape{gridnode}
{
    \savedmacro{\ctikzclass}{\edef\ctikzclass{blocks}}
    \saveddimen{\scaledRlen}{\pgfmathsetlength{\pgf@x}{\ctikzvalof{\ctikzclass/scale}\pgf@circ@Rlen}}
    \savedmacro{\gridlines}{\edef\gridlines{\ctikzvalof{blocks/gridnode/gridlines}}}
    \savedanchor\northwest{
        \pgfmathsetlength{\pgf@circ@scaled@Rlen}{\ctikzvalof{\ctikzclass/scale}\pgf@circ@Rlen}
            \pgf@y=\ctikzvalof{quadpoles/gridnode/width}\pgf@circ@scaled@Rlen
            \pgf@y=.5\pgf@y
            \pgf@x=-\ctikzvalof{quadpoles/gridnode/width}\pgf@circ@scaled@Rlen
            \pgf@x=.5\pgf@x
    }
    \pgfcirc@northwest@symmetric@geoanchors
    \pgcirc@twoport@additional@northwest@anchors
    \anchor{center}{\pgfpointorigin}
    \anchor{right}{\northwest\pgf@y=0pt\pgf@x=-\pgf@x}
    \anchor{left}{\northwest\pgf@y=0pt}
    % text anchor, in the south-east corner
    \savedanchor{\textheight}{%
        \pgf@y= \ht\pgfnodeparttextbox %
    }
    \anchor{text}{\pgfextracty{\pgf@ya}{\textheight}
        \northwest \pgf@x=-1.1\pgf@x \pgf@y=-\pgf@y
        \advance\pgf@y by -0.1\pgf@ya
    }
    \pgf@circ@draw@component{
        \pgf@circ@setcolor
        \pgf@circ@scaled@Rlen=\scaledRlen
        \pgf@circ@res@step=\ctikzvalof{quadpoles/gridnode/width}\pgf@circ@scaled@Rlen
        \northwest
        \pgf@circ@res@up = \pgf@y
        \pgf@circ@res@down = -\pgf@y
        \pgf@circ@res@right = -\pgf@x
        \pgf@circ@res@left = \pgf@x
        \pgf@circ@res@step = \ctikzvalof{quadpoles/gridnode/width}\pgf@circ@scaled@Rlen
        \divide \pgf@circ@res@step by 2
        \pgfpathmoveto{\pgfpoint{\pgf@circ@res@left}{\pgf@circ@res@zero}}
        \pgf@circ@res@other = \pgf@circ@res@left
        \advance\pgf@circ@res@other by \pgf@circ@res@step
        \pgfcirc@twoport@maybedash
        % draw outer box
        \pgfstartlinewidth=\pgflinewidth
        \pgf@circ@twoportbox
        \pgf@circ@inputarrow
        \ifpgf@circuit@full@dashed\else\pgfsetdash{}{0pt}\fi
        \pgfsetarrows{-} %never draw arrows
        \pgfstartlinewidth=\pgflinewidth
        \pgf@circ@subset@color{blocks/inner color}
        \pgf@circ@set@relative@thickness{inner thickness}
        % draw grid
        \ifodd\gridlines
        	\edef\gridmiddleline{\numexpr(\gridlines+1)/2\relax}
        \else
        	\edef\gridmiddleline{\numexpr\gridlines/2+1\relax}
       	\fi
        \foreach \line in {\gridmiddleline,...,\gridlines}
       	{
            \pgfmathsetmacro\relpos{4*\line/(\gridlines+1) - 3}
            \pgfpathmoveto{\pgfpoint{\relpos\pgf@circ@res@right}{\pgf@circ@res@up}}
            \pgfpathlineto{\pgfpoint{\pgf@circ@res@right}{\relpos\pgf@circ@res@up}}
            \pgfpathmoveto{\pgfpoint{\relpos\pgf@circ@res@left}{\pgf@circ@res@up}}
            \pgfpathlineto{\pgfpoint{\pgf@circ@res@left}{\relpos\pgf@circ@res@up}}
        }
        %prevent from draw the inner cross twice
        \foreach \line in {1,...,\numexpr\gridmiddleline-1\relax}
        {
            \pgfmathsetmacro\relpos{1 - 4*\line/(\gridlines+1)}
            \pgfpathmoveto{\pgfpoint{\relpos\pgf@circ@res@right}{\pgf@circ@res@down}}
            \pgfpathlineto{\pgfpoint{\pgf@circ@res@right}{\relpos\pgf@circ@res@down}}
            \pgfpathmoveto{\pgfpoint{\relpos\pgf@circ@res@left}{\pgf@circ@res@down}}
            \pgfpathlineto{\pgfpoint{\pgf@circ@res@left}{\relpos\pgf@circ@res@down}}
      	}
        \pgfusepath{draw}
    }
}
