\def\hobby@quick#1{%
  \hobby@quick@compute{#1}%
  \tikz@make@last@position{\hobby@qpointa}%
  \pgfutil@ifnextchar\relax{%
%    \end{macrocode}
% End of loop
%    \begin{macrocode}
    \hobby@quick@computeend%
  }{%
%    \end{macrocode}
% More to go, scan in the next coordinate and off we go again.
%    \begin{macrocode}
    \pgfutil@ifnextchar.{%
      \hobby@qswallowdots}{%
      \tikz@scan@one@point\hobby@quick}}}
%    \end{macrocode}
% \end{macro}
