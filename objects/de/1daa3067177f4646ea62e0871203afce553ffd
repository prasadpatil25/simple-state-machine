  \edef\tikz@timer@end{\noexpand\pgfqpoint{\the\pgf@x}{\the\pgf@y}}%
  \ifx\hobby@collected@onpath\pgfutil@empty
  \else
  \expandafter\hobby@nodes@onpath\hobby@collected@onpath\relax\relax
  \fi
