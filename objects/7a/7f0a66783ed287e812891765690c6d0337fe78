        \textbf{Received:} \gstreceived.\quad
        \textbf{Accepted:} \gstaccepted.\quad
        \textbf{Published:} \gstpublished.\par}
      \vspace{5mm}
    \end{@twocolumnfalse}
  ]
  \thispagestyle{gstfirst}
}

