%
%  \begin{macro}{\@backup@outputbox@depth}
%    In some places we have to make the depth of the \cs{@outputbox}
%    zero by backing up by its current depth. This is done by
%    \cs{@backup@outputbox@depth}. The macro can only be used inside
%    of \cs{@outputbox@append} (or after you have manually set the
%    \cs{@outputbox@depth} to the right value).
%
%    If the depth is zero, there is no point in doing anything, and if
%    the depth is negative it must have been deliberately set to this
%    value, so in this case we also do not back up and change it.
%
%    If it is positive we back up by the minimum of
%    \cs{@outputbox@depth} and \cs{maxdepth}, i.e., if the depth is
%    unusually large we do not perform a full backup.
%
%  \changes{v1.4r}{2025/03/25}{Macro added (footmisc/19)}
%    \begin{macrocode}
\def\@backup@outputbox@depth{%
%  \typeout{--> @backup@outputbox@depth : \the \@outputbox@depth}%
  \ifdim\@outputbox@depth>\z@
    \vskip -%
      \ifdim\@outputbox@depth>\maxdepth
        \maxdepth
      \else
        \@outputbox@depth
      \fi
%    \end{macrocode}
%    After the skip was added the depth of the box will become zero
%    but this is not immediately reflected in
%    \cs{@outputbox@depth}. Thus, if there is further code in the same
%    \cs{@outputbox@append} testing the register it would make a wrong
%    conclusion. We therefore set it locally to zero.
%    \begin{macrocode}
    \@outputbox@depth\z@    
  \fi
}
%    \end{macrocode}
%  \end{macro}
