      pickup rule_pen;

      draw (left_point + 5/6equal_spread * dir 90) -- (right_point + 5/6equal_spread * dir 90);
      draw sim(left_point - 1/2equal_spread * dir 90, right_point - 1/2equal_spread * dir 90);

      if negated = 1:
