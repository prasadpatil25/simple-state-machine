if negated < 2:
  beginorder(1, order_width# + rule_thickness#,
                3equal_spread# + ifneg(2dot_size#, equal_spread# + rule_thickness#));
    "dot equal";

    pickup rule_pen;

    z1 - z0 = equal_spread * dir 90;
    z3 - z2 = equal_spread * dir 90;

    1/2[z0, z1] = left_point;
    1/2[z2, z3] = right_point;

    draw z0 -- z2;
