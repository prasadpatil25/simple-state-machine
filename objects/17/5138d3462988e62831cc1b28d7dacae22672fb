\@ifpackageloaded{fontawesome7}{}{\PackageError{fontawesome7-generic-helper}{This package should not be loaded individually. Load fontawesome7 instead.}{}}

\ProvidesExplPackage{fontawesome7-generic-helper}{2026/10/11}{7.3.1-2}{non-uTeX helper for fontawesome7}

\cs_new_protected:Nn\__fontawesome_def_icon:nnnnn{
  \tl_if_empty:nF{#1}{
    \cs_new_protected:Npn#1{\faPreselectedIcon{#2}}
  }
  \tl_const:cn{c__fontawesome_slot_#2_tl}{{#3}{#4}}
}
\file_input:n{fontawesome7-mapping.def}
\cs_new_protected:Nn\__fontawesome_icon_at:nnnn{
  {
    \usefont
      {U}
      {fontawesome7#1}
      {#3}
      {n}
    \unless\iffontchar\font#2
      \fontseries{solid}
      \selectfont
      \iffontchar\font#2
        \msg_warning:nnxx{fontawesome7}{style-substitution}{#4}{#3}
      \else
        \msg_error:nnxx{fontawesome7}{icon-not-found}{#4}{#3}
      \fi
    \fi
    \char#2
  }
}
\cs_new_protected:Nn\fontawesome_use_icon:nn{
  \cs_if_exist:cTF{c__fontawesome_slot_#2_tl}{
    \bool_if:NTF\c__fontawesome_fixed_bool{
      \makebox[1.5em][c]
    }{
      \use:n
    }
    {
      \exp_last_unbraced:Nv
        \__fontawesome_icon_at:nnnn
        {c__fontawesome_slot_#2_tl}
          {#1}{#2}
    }
  }{
    \msg_error:nnxx{fontawesome7}{icon-not-found}{#2}{#1}
