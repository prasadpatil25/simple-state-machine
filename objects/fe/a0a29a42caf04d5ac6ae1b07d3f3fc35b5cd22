% \begin{macro}[EXP]{\cmd_arg_spec:N, \cmd_arg_spec:c}
% \changes{v1.3g}{2025/10/02}{New function}
% \begin{macro}[EXP]{\@@_arg_spec_opt:N}
% \changes{v1.3g}{2025/10/02}{New function}
%   First we check that the command passed does exist, and is one with the
%   correct form. It if does then there are two cases. For optimised commands,
%   we can reconstruct the arg.~spec.\ from the \TeX{} parameter spec, taking
%   care to add |+| if required. For the non-optimized cases, the
%   arg.~spec.\ is stored in the top-level macro. We treat this as a |tl| and
%   extract the appropriate balanced text: the second item.
%    \begin{macrocode}
\cs_new:Npn \cmd_arg_spec:N #1
  {
    \cs_if_exist:NTF #1
      {
        \__kernel_cmd_if_xparse:NTF #1
          {
            \exp_args:No \tl_if_head_eq_meaning:nNTF #1
              \@@_start_optimized:
              {
                \exp_args:Nc \@@_arg_spec_opt:N
                  { \cs_to_str:N #1 \c_space_tl code }
              }
              { \tl_item:Nn #1 { 2 } }
          }
          { X }
      }
      { X }
  }
\cs_generate_variant:Nn \cmd_arg_spec:N { c }
\cs_new:Npn \@@_arg_spec_opt:N #1
  {
    \prg_replicate:nn { \str_count:e { \cs_parameter_spec:N #1 } / 2 }
      {
        \bool_lazy_or:nnT
          { \token_if_long_macro_p:N #1 }
          { \token_if_protected_long_macro_p:N #1 }
          { + }
        m
      }
  }
%    \end{macrocode}
