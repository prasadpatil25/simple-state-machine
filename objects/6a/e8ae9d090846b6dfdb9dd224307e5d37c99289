        }
    }

    $r[3] = $y;                 # no push!

    # If $x and/or $y is Inf or NaN, return NaN.

    return $x -> bnan() if (!$x -> is_finite() || !$y -> is_finite());

    if ($x->{sign} eq '+' && $y->{sign} eq '+') {
        $x->{value} = $LIB->_or($x->{value}, $y->{value});
    } else {
