                \def\distfromline{-\tmpdistfromline}
            \else
                \def\distfromline{-\ctikzvalof{voltage/distance from line}\pgf@circ@Rlen}
            \fi
        \fi
        \else
            \ifpgf@circuit@bipole@inverted
                \ifpgf@circuit@bipole@voltage@straight
                    \def\distfromline{-\tmpdistfromline}
                \else
                    \def\distfromline{-\ctikzvalof{voltage/distance from line}\pgf@circ@Rlen}
                \fi
                \else
                \ifpgf@circuit@bipole@voltage@straight
                    \def\distfromline{\tmpdistfromline}
                \else
                    \def\distfromline{\ctikzvalof{voltage/distance from line}\pgf@circ@Rlen}
                \fi
            \fi
