% \changes{v1.8q}{2017/04/11}{Make \cs{clearpage} behave like \cs{newpage} (pr/4511)}
%    \begin{macrocode}
   \def\clearpage{%
     \ifx\@deferlist\@empty\else
       \PackageError{multicol}%
