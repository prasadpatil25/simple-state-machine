% \subsection{Supporting hooks}
%
%    Since \pkg{longtable} is supposed to work without loading
%    \pkg{array}, i.e., just with the \env{tabular} code from the
%    kernel and that code has no hooks. We therefore do not run any
%    hook if \pkg{array} is not loaded, because otherwise those
%    explicitly used in the \pkg{longtable} code would run, but the
%    corresponding ones that are only in the \pkg{array} code are not.
%    By default we assume \pkg{array} is not loaded.
%    \begin{macrocode}
\let \ArrayLoadedT \@gobble
%    \end{macrocode}
%    If it is we change and the hooks get executed.
%    \begin{macrocode}
\AddToHook{package/array/after}{\let \ArrayLoadedT \@firstofone}
