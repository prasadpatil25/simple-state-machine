\newcommand*\nmv@citex@nat{}
\newcommand*\nmv@activate{%
  \let\nmv@citex@nat\@citex
  \let\@citex\nmv@citex
  \let\nmv@cite\cite
  \renewcommand*{\cite}[2][]{%
    \nmv@ifmtarg{##1}{%
      \nmv@citetrue
      \nmv@cite{##2}%
    }{%
      \nmv@citefalse
      \nmv@cite[##1]{##2}}%
  }%
}
