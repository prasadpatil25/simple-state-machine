% \begin{macro}{\caption@redefine}
% \changes{v3.1}{2007/05/09}{Re-definition of \cs{@xfloat} added}
% \changes{v3.1b}{2007/09/22}{cs{@xfloat} will now be redefined in compatibility mode, too}
