        \pgfmathparse{%
            1-(3-sqrt(3)*2*\ctikzvalof{bipoles/ooosource/width}/\ctikzvalof{bipoles/ooosource/height})/
            ((2-sqrt(3))*2*\ctikzvalof{bipoles/ooosource/width}/\ctikzvalof{bipoles/ooosource/height}-1)
