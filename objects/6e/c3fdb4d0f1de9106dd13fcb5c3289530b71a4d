    %% we reverse that and we have
    %% r = (3-sqrt(3)*2*w/h)/((2-sqrt(3)*2*w/h-1)
    \savedmacro{\circlesize}{%
        \pgfmathparse{%
            (3-sqrt(3)*2*\ctikzvalof{bipoles/ooosource/width}/\ctikzvalof{bipoles/ooosource/height})/
            ((2-sqrt(3))*2*\ctikzvalof{bipoles/ooosource/width}/\ctikzvalof{bipoles/ooosource/height}-1)
        }
        \edef\circlesize{\pgfmathresult}
