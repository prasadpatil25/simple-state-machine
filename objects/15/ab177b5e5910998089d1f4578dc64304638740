%    the name of the input file or a list of names, separated by commas.
% \changes{2.5e}{2014/09/29}{Typo in \cs{Ask} argument fixed}
%    \begin{macrocode}
    \Ask\filelist{%
         * extension separated by commas if necessary %
                                  \space\space\space\space: *}%
