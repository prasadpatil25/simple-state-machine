                           }bp
                       }
                     \box_set_ht:Nn \l_@@_dest_box
                       {
                         \seq_item:Nn\l_@@_tmpa_seq{5}bp
                       }
                   }
               }
           }
           {
              \msg_warning:nnnn {hyp}{invalid-destination-value}{#1}{pdfview}
              \tl_set:Nn \l_@@_dest_pdfview_tl {fit}
           }
      }
    ,pdfview .initial:n  = {xyz}
