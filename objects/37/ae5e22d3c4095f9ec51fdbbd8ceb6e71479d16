                     \seq_put_right:Nn \l_@@_tmpa_seq  {0}
                     \seq_put_right:Nn \l_@@_tmpa_seq  {0}
                     \hbox_set_to_wd:Nnn \l_@@_dest_box
                       {
                         \fp_eval:n
                          {
                            round
                             (
                               abs
                                (
                                  \seq_item:Nn\l_@@_tmpa_seq{4}
                                  -
                                  (\seq_item:Nn\l_@@_tmpa_seq{2})
                                 ),
                                3
                             )
                          }bp
                       }{}
                     \box_set_dp:Nn \l_@@_dest_box
                       {
                         \fp_eval:n
                           {
