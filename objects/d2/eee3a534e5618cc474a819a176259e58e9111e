		}{%
			\PackageError{tikzscale}{Requested to scale unscalable graphic}{Do not set width or height for graphic in\MessageBreak #3}%
		}%
%    \end{macrocode}
		% We know, that the variable sized area scales with the scaling factor, thus it holds
