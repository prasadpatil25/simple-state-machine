% If |\hsize| seems not to be set correctly, we set it to |\linewidth|.
% \changes{v3.3}{2018/04/30}{Bugfix from Ulrike Fischer applied, see also \url{https://github.com/axelsommerfeldt/caption/issues/1}}
%    \begin{macrocode}
