\def\lrq@defparser#1{%
  \begingroup\@makeother\#%
  \lrq@defparser@i{#1}}

\def\lrq@defparser@i#1#2#3{%
  \endgroup
  \eappto\lrq@hook@init{%
    \def\expandafter\noexpand\csname#2\endcsname{%
      \noexpand#1{#2}}}%
  \listadd\lrq@lst@elm{#2}%
  \begingroup
  \lrq@indent\@ne
  \xappto\lrq@hook@dtd{\lrq@tab<!ELEMENT #2 \detokenize{#3}>\lrq@nl}%
  \endgroup}

