\def\subfigure{\subfloat}
%    \end{macrocode}
%
%
%    \begin{macrocode}
\@ifundefined{c@subtable}{\newsubfloat{table}}{}
\def\subtable{\subfloat}
%    \end{macrocode}
%
% \end{macro}
% \end{macro}
