  r := plus_size/2; % - 11/10rule_thickness;

  z1 - z0 = equal_spread * right;
  1/2[z0,z1] = centre;

  draw (z0 + r * up) -- (z0 + r * down);
  draw (z1 + r * up) -- (z1 + r * down);

