 {
   \__flowfram_only_document_env:Nn \FlowFramUnrestoreOR
    {
      \clearpage
      \cs_set_eq:NN \@opcol \__flowfram_op_col:
      \cs_set_eq:NN \@outputdblcol \__flowfram_output_dbl_col:
