%% put a negation wedge here
\def\pgf@circ@muxdemux@not@wedge#1#2#3#4#5{%
    % #1: which label: wi/wp with L,R,T,B
    % #2: anchor
    % #3: xscale
    % #4: yscale
    % #5: rotation
    % uses external variables \pgf@circ@count@a
